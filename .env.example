# --- Runtime ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Secrets loading (scripts/start-with-secrets.ts) ---
# local: use this .env file. aws: fetch one JSON secret from AWS Secrets Manager.
SECRETS_SOURCE=local
SECRET_ID=
AWS_REGION=

# --- Data stores ---
DATABASE_URL=postgresql://app:app@localhost:5442/realtime
REDIS_URL=redis://localhost:6381/0

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string-32-chars-min
JWT_EXPIRES_IN=1h

# --- Realtime ---
# How often each socket refreshes its presence entry, and how long an entry lives without refresh.
PRESENCE_HEARTBEAT_SECONDS=25
PRESENCE_TTL_SECONDS=60
# Most messages sent on reconnect before the client is told to page through REST instead.
REPLAY_LIMIT=500
